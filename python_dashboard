      "Error: 'df' not found in memory. Please run your import block first!"
  )

# monte carlo sim of 10k sim.
import numpy as np
import plotly.graph_objects as go

if "df" in globals():
  # determine baseline probability
  threshold_val = 2048
  p_33 = (df["Sensor_33 (Most)"] > threshold_val).mean()
  p_34 = (df["Sensor_34 (Medium)"] > threshold_val).mean()
  p_35 = (df["Sensor_35 (Least)"] > threshold_val).mean()

  print(f"Baseline active probabilities learned from data:")
  print(f" - Pin 33 (Most): {p_33:.3f}")
  print(f" - Pin 34 (Medium): {p_34:.3f}")
  print(f" - Pin 35 (Least): {p_35:.3f}")

  # monte carlo parameters
  num_simulations = 10000
  num_time_steps = len(df)

  anomaly_counts = []

  np.random.seed(42)  # result
  for _ in range(num_simulations):
    # adding randomness in form of jitter
    jitter = np.random.normal(0, 0.02, 3)
    sim_p33 = np.clip(p_33 + jitter[0], 0.01, 0.99)
    sim_p34 = np.clip(p_34 + jitter[1], 0.01, 0.99)
    sim_p35 = np.clip(p_35 + jitter[2], 0.01, 0.99)

    # simulate random states
    sim_33 = np.random.random(num_time_steps) < sim_p33
    sim_34 = np.random.random(num_time_steps) < sim_p34
    sim_35 = np.random.random(num_time_steps) < sim_p35

    # sum occurances
    sim_anomalies = np.sum(sim_33 & sim_34 & sim_35)
    anomaly_counts.append(sim_anomalies)

  # analysis
  mean_anomalies = np.mean(anomaly_counts)
  median_anomalies = np.median(anomaly_counts)
  max_anomalies = np.max(anomaly_counts)
  min_anomalies = np.min(anomaly_counts)

  print("\n--- Monte Carlo Simulation Results (10,000 Runs) ---")
  print(f"Average expected anomalies: {mean_anomalies:.1f}")
  print(f"Most likely scenario (Median): {median_anomalies:.0f}")
  print(f"Observed Range across simulations: {min_anomalies} to {max_anomalies}")

  # histogram plot
  fig = go.Figure(
      data=[
          go.Histogram(
              x=anomaly_counts,
              marker_color="#00e5ff",
              opacity=0.8,
              nbinsx=40,
          )
      ]
  )

  fig.update_layout(
      template="plotly_dark",
      height=500,
      title_text=(
          "<b>MONTE CARLO SIMULATION (10k Runs)</b> - Anomaly Count"
          " Distribution"
      ),
      xaxis_title="Number of Simultaneous Anomalies Detected",
      yaxis_title="Frequency (Trial Count)",
      paper_bgcolor="rgb(17, 17, 17)",
      plot_bgcolor="rgb(17, 17, 17)",
      hovermode="x",
  )

  fig.update_xaxes(showgrid=True, gridcolor="#333333")
  fig.update_yaxes(showgrid=True, gridcolor="#333333")

  fig.show()

