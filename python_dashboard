import io
import time
import pandas as pd
import serial

port = "COM3"
baudrate = 115200

print(f"Connecting to ESP32 on {port}...")
ser = serial.Serial(port, baudrate, timeout=3)
time.sleep(2)

ser.write(b"READ\n")
time.sleep(0.5)

print("Reading data stream...")
raw_lines = []
start_time = time.time()
while time.time() - start_time < 3.0:
  if ser.in_waiting > 0:
    line = ser.readline().decode("utf-8", errors="ignore").strip()
    if line:
      raw_lines.append(line)
      start_time = time.time()

ser.close()

# creating collumns for 3 sensors
csv_data = []
for line in raw_lines:
  if (
      "," in line
      and line.count(",") == 2
      and not line.startswith("-")
      and not any(c.isalpha() for c in line)
  ):
    csv_data.append(line)

if csv_data:
  csv_string = "\n".join(csv_data)
  # save into memory
  df = pd.read_csv(
      io.StringIO(csv_string),
      header=None,
      names=["Sensor_34 (Medium)", "Sensor_35 (Least)", "Sensor_33 (Most)"],
  )
  df.insert(0, "Time (s)", [round(i * 0.1, 1) for i in range(len(df))])

  print(
      "\n--- Table successfully loaded into memory as 'df' ---"
      f" ({len(df)} rows loaded)"
  )
  print(df.head())
else:
  print("No valid CSV data captured. Check your serial output.")

