# stress sensor maps
import numpy as np
from plotly.subplots import make_subplots
import plotly.graph_objects as go

if "df" in globals():
  # probability baselines
  threshold_val = 2048
  p_33 = (df["Sensor_33 (Most)"] > threshold_val).mean()
  p_34 = (df["Sensor_34 (Medium)"] > threshold_val).mean()
  p_35 = (df["Sensor_35 (Least)"] > threshold_val).mean()

  num_time_steps = len(df)

  # defining stress parameters
  noise_levels = np.linspace(0.0, 0.15, 10)
  threshold_factors = np.linspace(0.8, 1.2, 10)

  # Grids for each individual sensor
  grid_33 = np.zeros((len(threshold_factors), len(noise_levels)))
  grid_34 = np.zeros((len(threshold_factors), len(noise_levels)))
  grid_35 = np.zeros((len(threshold_factors), len(noise_levels)))

  np.random.seed(42)

  # monte carlo sim.
  for i, t_factor in enumerate(threshold_factors):
    adj_thresh = threshold_val * t_factor
    eff_p33 = (df["Sensor_33 (Most)"] > adj_thresh).mean()
    eff_p34 = (df["Sensor_34 (Medium)"] > adj_thresh).mean()
    eff_p35 = (df["Sensor_35 (Least)"] > adj_thresh).mean()

    for j, noise in enumerate(noise_levels):
      counts_33, counts_34, counts_35 = [], [], []

      for _ in range(150):  # 150 runs per cell
        jitter = np.random.normal(0, noise, 3)
        s_p33 = np.clip(eff_p33 + jitter[0], 0.001, 0.999)
        s_p34 = np.clip(eff_p34 + jitter[1], 0.001, 0.999)
        s_p35 = np.clip(eff_p35 + jitter[2], 0.001, 0.999)

        sim_33 = np.random.random(num_time_steps) < s_p33
        sim_34 = np.random.random(num_time_steps) < s_p34
        sim_35 = np.random.random(num_time_steps) < s_p35

        counts_33.append(np.sum(sim_33))
        counts_34.append(np.sum(sim_34))
        counts_35.append(np.sum(sim_35))

      grid_33[i, j] = np.mean(counts_33)
      grid_34[i, j] = np.mean(counts_34)
      grid_35[i, j] = np.mean(counts_35)

  x_labels = [f"{n*100:.1f}%" for n in noise_levels]
  y_labels = [f"{tf:.2f}x" for tf in threshold_factors]

  # subplot comparison
  fig = make_subplots(
      rows=1,
    cols=3,
      subplot_titles=(
          "Pin 33: Most Holes",
          "Pin 34: Medium Holes",
          "Pin 35: Least Holes",
      ),
      shared_yaxes=True,
      horizontal_spacing=0.08,
  )

  # add heatmap
  fig.add_trace(
      go.Heatmap(
          z=grid_33,
          x=x_labels,
          y=y_labels,
          colorscale="Plasma",
          showscale=False,
      ),
      row=1,
      col=1,
  )
  fig.add_trace(
      go.Heatmap(
          z=grid_34,
          x=x_labels,
          y=y_labels,
          colorscale="Plasma",
          showscale=False,
      ),
      row=1,
      col=2,
  )
  fig.add_trace(
      go.Heatmap(
          z=grid_35,
          x=x_labels,
          y=y_labels,
          colorscale="Plasma",
          colorbar=dict(title="Avg Active Count"),
      ),
      row=1,
      col=3,
  )

  # layout style
  fig.update_layout(
      template="plotly_dark",
      height=550,
      title_text=(
          "<b>INDIVIDUAL SENSOR ACTIVITY MAPS - Noise vs Threshold Sensitivity Comparison"
      ),
      paper_bgcolor="rgb(17, 17, 17)",
      plot_bgcolor="rgb(17, 17, 17)",
  )

  fig.update_xaxes(title_text="Noise Jitter Intensity", row=1, col=2)
  fig.update_yaxes(title_text="Threshold Multiplier", row=1, col=1)

  fig.show()

